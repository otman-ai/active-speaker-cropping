# Get an NVIDIA API key from NVIDIA Build. Never commit a real key.
NVCF_API_KEY=your_nvidia_api_key

# Active Speaker Detection function ID from its NVIDIA Build API page.
NVCF_FUNCTION_ID=your_active_speaker_detection_function_id

# Hosted Nemotron ASR defaults are filled in by run_workflow.py.
# RIVA_API_KEY defaults to NVCF_API_KEY; override only if needed.
RIVA_API_KEY=
RIVA_SERVER=grpc.nvcf.nvidia.com:443
RIVA_SSL=true
RIVA_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
RIVA_LANGUAGE=en-US
RIVA_MAX_SPEAKERS=5

# Face height in the 9:16 output crop, from 0.05 to 0.8.
FACE_FRACTION=0.24
